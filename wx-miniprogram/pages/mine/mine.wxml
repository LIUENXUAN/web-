<view class="page">
  <view class="user-card">
    <view class="avatar">👤</view>
    <view class="user-info">
      <text class="user-name">{{userName || '微信用户'}}</text>
      <text class="user-desc">Nature Haven 营友</text>
    </view>
    <button class="login-btn" wx:if="{{!loggedIn}}" bindtap="doLogin">微信登录</button>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">提交反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="section-title">
    <text>我的报名</text>
  </view>

  <view wx:if="{{!loggedIn}}" class="empty">
    <text>请先登录查看报名记录</text>
  </view>

  <view wx:elif="{{loading}}" class="loading"><text>加载中...</text></view>

  <view wx:elif="{{signups.length == 0}}" class="empty">
    <text>暂无报名记录</text>
  </view>

  <view wx:else class="signup-list">
    <view class="signup-card" wx:for="{{signups}}" wx:key="id" data-id="{{item.activityId}}" bindtap="goDetail">
      <view class="signup-top">
        <text class="signup-title">{{item.name}}</text>
        <text class="signup-phone">{{item.phone}}</text>
      </view>
      <text class="signup-time">报名时间: {{item.createdAt}}</text>
    </view>
  </view>
</view>