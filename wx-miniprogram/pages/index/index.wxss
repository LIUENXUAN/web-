.page {
  padding: 0 32rpx 120rpx;
  min-height: 100vh;
  display: block;
}

.header {
  text-align: center;
  padding: 60rpx 0 48rpx;
  position: relative;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.brand-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.brand-text {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: #f3efe4;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8fa96f;
  letter-spacing: 4rpx;
  font-weight: 500;
}

.section-title {
  margin: 40rpx 0 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title .title-main {
  font-size: 32rpx;
  font-weight: 800;
  color: #f3efe4;
}

.section-sub {
  font-size: 22rpx;
  color: #5a724a;
  font-weight: 500;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #5a724a;
  font-size: 28rpx;
}

.activity-list {
  display: block;
}

.activity-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: block;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  flex: 1;
  line-height: 1.4;
  color: #f3efe4;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
  letter-spacing: 1rpx;
}

.status-open {
  background: rgba(107, 207, 138, 0.2);
  color: #6bcf8a;
  border: 1px solid rgba(107, 207, 138, 0.3);
}

.status-full {
  background: rgba(232, 112, 96, 0.2);
  color: #e87060;
  border: 1px solid rgba(232, 112, 96, 0.3);
}

.status-closed {
  background: rgba(45, 55, 40, 0.5);
  color: #5a724a;
  border: 1px solid rgba(90, 114, 74, 0.3);
}

.card-body {
  display: block;
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 24rpx;
  color: rgba(243, 239, 228, 0.6);
}

.progress-wrap {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.2);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.progress-fill {
  height: 100%;
  background: #6bcf8a;
  border-radius: 999rpx;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(243, 239, 228, 0.7);
  flex-shrink: 0;
  font-weight: 600;
}
