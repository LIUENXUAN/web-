.page {
  padding: 0 32rpx 120rpx;
  min-height: 100vh;
}

.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: #5a724a;
  font-size: 28rpx;
}

.hero-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #f3efe4;
  flex: 1;
  line-height: 1.3;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.status-open {
  background: rgba(107, 207, 138, 0.2);
  color: #6bcf8a;
  border: 1px solid rgba(107, 207, 138, 0.3);
}

.status-full {
  background: rgba(232, 112, 96, 0.2);
  color: #e87060;
  border: 1px solid rgba(232, 112, 96, 0.3);
}

.status-closed {
  background: rgba(45, 55, 40, 0.5);
  color: #5a724a;
  border: 1px solid rgba(90, 114, 74, 0.3);
}

.hero-meta {
  margin-bottom: 20rpx;
}

.hero-meta text {
  display: block;
  font-size: 26rpx;
  color: rgba(243, 239, 228, 0.7);
  margin-bottom: 8rpx;
}

.progress-wrap {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.2);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.progress-fill {
  height: 100%;
  background: #6bcf8a;
  border-radius: 999rpx;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(243, 239, 228, 0.7);
  flex-shrink: 0;
  font-weight: 600;
}

.desc-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.desc-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #6bcf8a;
  display: block;
  margin-bottom: 12rpx;
}

.desc-content {
  font-size: 26rpx;
  color: rgba(243, 239, 228, 0.85);
  line-height: 1.6;
  display: block;
}

.form-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f3efe4;
  display: block;
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #f3efe4;
  margin-bottom: 16rpx;
}

.form-input::placeholder {
  color: rgba(243, 239, 228, 0.4);
}

.btn-primary {
  width: 100%;
  background: #6bcf8a;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 12rpx;
}

.status-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 40rpx 28rpx;
  text-align: center;
}

.status-card text {
  font-size: 28rpx;
  color: rgba(243, 239, 228, 0.8);
  display: block;
  margin-bottom: 20rpx;
}

.btn-cancel {
  display: inline-block;
  background: rgba(232, 112, 96, 0.15);
  color: #e87060;
  border: 1px solid rgba(232, 112, 96, 0.3);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}